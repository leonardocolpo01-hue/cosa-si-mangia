rules_version = '2';
// Ogni famiglia sta sotto famiglie/{codice}. Il codice è lungo e casuale:
// chi non lo conosce non può leggere né elencare le famiglie.
service cloud.firestore {
  match /databases/{database}/documents {
    match /famiglie/{fam} {
      allow get, create, update: if request.auth != null && fam.size() >= 16;
      match /{document=**} {
        allow read, write: if request.auth != null && fam.size() >= 16;
      }
    }
  }
}
